# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SERVER_ENCRYPTION_KEY: 32-byte hex or passphrase used to encrypt sensitive PII (Iqama/Passport)
# and generate keyed HMAC-SHA256 hashes for duplicate detection & QR verification tokens.
SERVER_ENCRYPTION_KEY="CHANGE_ME_IN_PRODUCTION_TO_A_32_BYTE_SECRET"

# Optional SMTP Configuration (can also be configured in Super Admin > Company & Integration Settings)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_SENDER_NAME="TCMS Enterprise"

# Optional Official WhatsApp Business Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
