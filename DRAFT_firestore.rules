    function isValidCompanySettings(data) {
      return data.keys().hasAll(['nameEn', 'nameAr', 'primaryColor', 'secondaryColor', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'nameEn', 'nameAr', 'legalName', 'crNumber', 'address', 'phone', 'email', 'website', 'logoFileId', 'stampFileId', 'signatoryName', 'signatureFileId', 'primaryColor', 'secondaryColor', 'certificateFooter', 'cardFooter', 'updatedBy', 'updatedAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.nameEn is string && data.nameEn.size() <= 200
        && data.nameAr is string && data.nameAr.size() <= 200
        && (!('legalName' in data) || (data.legalName is string && data.legalName.size() <= 240))
        && (!('crNumber' in data) || (data.crNumber is string && data.crNumber.size() <= 64))
        && (!('address' in data) || (data.address is string && data.address.size() <= 400))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('website' in data) || (data.website is string && data.website.size() <= 200))
        && (!('logoFileId' in data) || (data.logoFileId is string && data.logoFileId.size() <= 256))
        && (!('stampFileId' in data) || (data.stampFileId is string && data.stampFileId.size() <= 256))
        && (!('signatoryName' in data) || (data.signatoryName is string && data.signatoryName.size() <= 160))
        && (!('signatureFileId' in data) || (data.signatureFileId is string && data.signatureFileId.size() <= 256))
        && data.primaryColor is string && data.primaryColor.size() <= 16
        && data.secondaryColor is string && data.secondaryColor.size() <= 16
        && (!('certificateFooter' in data) || (data.certificateFooter is string && data.certificateFooter.size() <= 400))
        && (!('cardFooter' in data) || (data.cardFooter is string && data.cardFooter.size() <= 400))
        && data.updatedBy is string && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['type', 'titleEn', 'titleAr', 'bodyEn', 'bodyAr', 'read', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'targetUserId', 'targetRole', 'organizationId', 'type', 'category', 'channel', 'deliveryStatus', 'recipient', 'candidateDocId', 'candidateId', 'enrollmentId', 'trainingCardId', 'certificateId', 'attachmentFileId', 'titleEn', 'titleAr', 'bodyEn', 'bodyAr', 'read', 'createdAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && (!('targetUserId' in data) || (data.targetUserId is string && data.targetUserId.size() <= 128))
        && (!('targetRole' in data) || (data.targetRole is string && data.targetRole.size() <= 64))
        && (!('organizationId' in data) || (data.organizationId is string && data.organizationId.size() <= 128))
        && data.type is string && data.type.size() <= 64
        && (!('category' in data) || (data.category is string && data.category.size() <= 64))
        && (!('channel' in data) || data.channel in ['in_app', 'email', 'whatsapp', 'whatsapp_manual'])
        && (!('deliveryStatus' in data) || data.deliveryStatus in ['pending', 'queued', 'sent', 'delivered', 'failed', 'retry_required', 'manual_initiated'])
        && (!('recipient' in data) || (data.recipient is string && data.recipient.size() <= 200))
        && (!('candidateDocId' in data) || (data.candidateDocId is string && data.candidateDocId.size() <= 128))
        && (!('candidateId' in data) || (data.candidateId is string && data.candidateId.size() <= 64))
        && (!('enrollmentId' in data) || (data.enrollmentId is string && data.enrollmentId.size() <= 128))
        && (!('trainingCardId' in data) || (data.trainingCardId is string && data.trainingCardId.size() <= 128))
        && (!('certificateId' in data) || (data.certificateId is string && data.certificateId.size() <= 128))
        && (!('attachmentFileId' in data) || (data.attachmentFileId is string && data.attachmentFileId.size() <= 256))
        && data.titleEn is string && data.titleEn.size() <= 200
        && data.titleAr is string && data.titleAr.size() <= 200
        && data.bodyEn is string && data.bodyEn.size() <= 1000
        && data.bodyAr is string && data.bodyAr.size() <= 1000
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidMessageTemplate(data) {
      return data.keys().hasAll(['code', 'category', 'nameEn', 'nameAr', 'subjectEn', 'subjectAr', 'bodyEn', 'bodyAr', 'isActive', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'code', 'category', 'nameEn', 'nameAr', 'subjectEn', 'subjectAr', 'bodyEn', 'bodyAr', 'whatsappTemplateName', 'whatsappLanguageEn', 'whatsappLanguageAr', 'useApprovedMetaTemplate', 'placeholders', 'isActive', 'updatedBy', 'createdAt', 'updatedAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 80
        && data.category in ['candidate_registration', 'enrollment_confirmation', 'training_schedule', 'training_reminder', 'training_card_delivery', 'attendance_notification', 'examination_schedule', 'examination_result', 'certificate_issuance', 'certificate_pdf_delivery', 'certificate_expiry_reminder']
        && data.nameEn is string && data.nameEn.size() >= 2 && data.nameEn.size() <= 200
        && data.nameAr is string && data.nameAr.size() >= 2 && data.nameAr.size() <= 200
        && data.subjectEn is string && data.subjectEn.size() <= 240
        && data.subjectAr is string && data.subjectAr.size() <= 240
        && data.bodyEn is string && data.bodyEn.size() <= 3000
        && data.bodyAr is string && data.bodyAr.size() <= 3000
        && (!('whatsappTemplateName' in data) || (data.whatsappTemplateName is string && data.whatsappTemplateName.size() <= 160))
        && (!('whatsappLanguageEn' in data) || (data.whatsappLanguageEn is string && data.whatsappLanguageEn.size() <= 24))
        && (!('whatsappLanguageAr' in data) || (data.whatsappLanguageAr is string && data.whatsappLanguageAr.size() <= 24))
        && (!('useApprovedMetaTemplate' in data) || data.useApprovedMetaTemplate is bool)
        && (!('placeholders' in data) || (data.placeholders is list && data.placeholders.size() <= 30 && (data.placeholders.size() == 0 || data.placeholders[0] is string)))
        && data.isActive is bool
        && data.updatedBy is string && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidImportJob(data) {
      return data.keys().hasAll(['jobId', 'importType', 'fileName', 'totalRows', 'importedCount', 'duplicateCount', 'invalidCount', 'skippedCount', 'failedCount', 'status', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'jobId', 'importType', 'organizationId', 'fileName', 'uploadedByName', 'uploadedByEmail', 'totalRows', 'importedCount', 'updatedCount', 'duplicateCount', 'invalidCount', 'skippedCount', 'failedCount', 'status', 'createdBy', 'createdAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.jobId is string && data.jobId.size() >= 3 && data.jobId.size() <= 64
        && data.importType in ['candidates', 'corporate_employees', 'enrollment_requests', 'enrollments', 'attendance', 'courses', 'trainers']
        && (!('organizationId' in data) || (data.organizationId is string && data.organizationId.size() <= 128))
        && data.fileName is string && data.fileName.size() <= 255
        && (!('uploadedByName' in data) || (data.uploadedByName is string && data.uploadedByName.size() <= 160))
        && (!('uploadedByEmail' in data) || (data.uploadedByEmail is string && data.uploadedByEmail.size() <= 200))
        && data.totalRows is number && data.totalRows >= 0
        && data.importedCount is number && data.importedCount >= 0
        && (!('updatedCount' in data) || (data.updatedCount is number && data.updatedCount >= 0))
        && data.duplicateCount is number && data.duplicateCount >= 0
        && data.invalidCount is number && data.invalidCount >= 0
        && data.skippedCount is number && data.skippedCount >= 0
        && data.failedCount is number && data.failedCount >= 0
        && data.status in ['completed', 'completed_with_errors', 'failed', 'cancelled']
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorRole', 'action', 'entityType', 'entityId', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'actorUid', 'actorEmail', 'actorRole', 'action', 'entityType', 'entityId', 'details', 'createdAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.actorUid is string && data.actorUid.size() <= 128
        && (!('actorEmail' in data) || (data.actorEmail is string && data.actorEmail.size() <= 200))
        && data.actorRole is string && data.actorRole.size() <= 64
        && data.action is string && data.action.size() <= 120
        && data.entityType is string && data.entityType.size() <= 80
        && data.entityId is string && data.entityId.size() <= 128
        && (!('details' in data) || (data.details is string && data.details.size() <= 2000))
        && data.createdAt is timestamp;
    }

    function isValidVerificationLog(data) {
      return data.keys().hasAll(['mode', 'query', 'resultStatus', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'mode', 'query', 'resultStatus', 'certificateNumber', 'actorUid', 'createdAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.mode in ['public', 'internal']
        && data.query is string && data.query.size() <= 200
        && data.resultStatus is string && data.resultStatus.size() <= 64
        && (!('certificateNumber' in data) || (data.certificateNumber is string && data.certificateNumber.size() <= 64))
        && (!('actorUid' in data) || (data.actorUid is string && data.actorUid.size() <= 128))
        && data.createdAt is timestamp;
    }

    function isValidDeliveryLog(data) {
      return data.keys().hasAll(['channel', 'recipient', 'messageType', 'deliveryStatus', 'sentBy', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'channel', 'recipient', 'recipientName', 'messageType', 'category', 'templateId', 'language', 'titleEn', 'titleAr', 'messagePreview', 'providerMessageId', 'deliveryStatus', 'failureReason', 'providerStatusDetails', 'entityId', 'candidateDocId', 'candidateId', 'enrollmentId', 'trainingCardId', 'certificateId', 'organizationId', 'attachmentFileId', 'manualUrl', 'retryCount', 'lastRetryAt', 'deliveredAt', 'sentBy', 'createdAt', 'updatedAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.channel in ['in_app', 'email', 'whatsapp', 'whatsapp_manual']
        && data.recipient is string && data.recipient.size() <= 200
        && (!('recipientName' in data) || (data.recipientName is string && data.recipientName.size() <= 200))
        && data.messageType is string && data.messageType.size() <= 80
        && (!('category' in data) || (data.category is string && data.category.size() <= 80))
        && (!('templateId' in data) || (data.templateId is string && data.templateId.size() <= 128))
        && (!('language' in data) || data.language in ['en', 'ar', 'bilingual'])
        && (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 240))
        && (!('titleAr' in data) || (data.titleAr is string && data.titleAr.size() <= 240))
        && (!('messagePreview' in data) || (data.messagePreview is string && data.messagePreview.size() <= 2000))
        && (!('providerMessageId' in data) || (data.providerMessageId is string && data.providerMessageId.size() <= 200))
        && data.deliveryStatus in ['pending', 'queued', 'sent', 'delivered', 'failed', 'retry_required', 'manual_initiated']
        && (!('failureReason' in data) || (data.failureReason is string && data.failureReason.size() <= 500))
        && (!('providerStatusDetails' in data) || (data.providerStatusDetails is string && data.providerStatusDetails.size() <= 500))
        && (!('entityId' in data) || (data.entityId is string && data.entityId.size() <= 128))
        && (!('candidateDocId' in data) || (data.candidateDocId is string && data.candidateDocId.size() <= 128))
        && (!('candidateId' in data) || (data.candidateId is string && data.candidateId.size() <= 64))
        && (!('enrollmentId' in data) || (data.enrollmentId is string && data.enrollmentId.size() <= 128))
        && (!('trainingCardId' in data) || (data.trainingCardId is string && data.trainingCardId.size() <= 128))
        && (!('certificateId' in data) || (data.certificateId is string && data.certificateId.size() <= 128))
        && (!('organizationId' in data) || (data.organizationId is string && data.organizationId.size() <= 128))
        && (!('attachmentFileId' in data) || (data.attachmentFileId is string && data.attachmentFileId.size() <= 256))
        && (!('manualUrl' in data) || (data.manualUrl is string && data.manualUrl.size() <= 2000))
        && (!('retryCount' in data) || (data.retryCount is number && data.retryCount >= 0 && data.retryCount <= 100))
        && (!('lastRetryAt' in data) || (data.lastRetryAt is string && data.lastRetryAt.size() <= 40))
        && (!('deliveredAt' in data) || (data.deliveredAt is string && data.deliveredAt.size() <= 40))
        && data.sentBy is string && data.sentBy.size() <= 128
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidSystemSettings(data) {
      return data.keys().hasAll(['key', 'config', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'key', 'config', 'updatedBy', 'updatedAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.key is string && data.key.size() <= 64
        && data.config is map
        && data.updatedBy is string && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidCounter(data) {
      return data.keys().hasAll(['prefix', 'value', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'prefix', 'value', 'updatedAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.prefix is string && data.prefix.size() <= 32
        && data.value is number && data.value >= 0
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // SaaS Platform Collection Rules
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if true;
    }

    match /saasTenants/{tenantId} {
      allow get: if isValidId(tenantId) && isVerified() && (
        isPlatformSuperAdmin() ||
        tenantId == 'tenant_default' ||
        hasTenantMembership(tenantId) ||
        userTenantId() == tenantId ||
        hasPendingInviteForTenant(tenantId) ||
        ownsActiveRegisteredTenant(tenantId)
      );
      allow list: if isVerified() && (
        isPlatformSuperAdmin() ||
        existing().tenantId == userTenantId() ||
        hasTenantMembership(existing().tenantId) ||
        ('ownerUserId' in existing() && existing().ownerUserId == request.auth.uid)
      );
      allow create: if isValidId(tenantId) && isVerified() && isValidSaasTenant(incoming())
        && isValidTimestamp(incoming().createdAt)
        && isValidTimestamp(incoming().updatedAt)
        && (
          isPlatformSuperAdmin() ||
          (
            tenantId == 'tenant_default' &&
            incoming().tenantId == 'tenant_default' &&
            incoming().isDefaultLegacyTenant == true &&
            incoming().status == 'active'
          ) ||
          (
            hasPendingTenantRegistration(tenantId) &&
            incoming().tenantId == tenantId &&
            incoming().ownerUserId == request.auth.uid &&
            incoming().createdBy == request.auth.uid &&
            incoming().isDefaultLegacyTenant == false &&
            incoming().status in ['trial', 'active']
          )
        );
      allow update: if isValidId(tenantId) && isVerified() && isValidSaasTenant(incoming())
        && isValidTimestamp(incoming().updatedAt)
        && incoming().createdAt == existing().createdAt
        && incoming().tenantId == existing().tenantId
        && (
          isPlatformSuperAdmin() ||
          (
            hasTenantMembership(tenantId) &&
            tenantMembershipRole(tenantId) in ['super_admin', 'tenant_owner'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['nameEn', 'nameAr', 'legalName', 'contactEmail', 'contactPhone', 'country', 'defaultLanguage', 'timezone', 'onboardingCompleted', 'updatedAt'])
          )
        );
      allow delete: if isValidId(tenantId) && isPlatformSuperAdmin() && tenantId != 'tenant_default';
    }

    match /saasUsers/{userId} {
      allow get: if isValidId(userId) && isVerified() && (request.auth.uid == userId || isPlatformSuperAdmin());
      allow list: if isVerified() && (isPlatformSuperAdmin() || existing().uid == request.auth.uid);
      allow create: if isValidId(userId) && isVerified() && isValidSaasUser(incoming())
        && isValidTimestamp(incoming().createdAt)
        && isValidTimestamp(incoming().updatedAt)
        && (
          (
            request.auth.uid == userId &&
            incoming().uid == request.auth.uid &&
            incoming().email.lower() == tokenEmailLower() &&
            incoming().status == 'active' &&
            (
              !('platformRole' in incoming()) ||
              (isBootstrappedSuperAdmin() && incoming().platformRole == 'platform_super_admin')
            )
          ) ||
          isPlatformSuperAdmin()
        );
      allow update: if isValidId(userId) && isVerified() && isValidSaasUser(incoming())
        && isValidTimestamp(incoming().updatedAt)
        && incoming().createdAt == existing().createdAt
        && incoming().uid == existing().uid
        && (
          isPlatformSuperAdmin() ||
          (
            request.auth.uid == userId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'preferredLanguage', 'defaultTenantId', 'updatedAt']) &&
            (!incoming().diff(existing()).affectedKeys().hasAny(['defaultTenantId']) || ('defaultTenantId' in incoming() && (hasTenantMembership(incoming().defaultTenantId) || hasPendingInviteForTenant(incoming().defaultTenantId) || ownsActiveRegisteredTenant(incoming().defaultTenantId)))) &&
            incoming().status == existing().status
          )
        );
      allow delete: if isValidId(userId) && isPlatformSuperAdmin() && userId != request.auth.uid;
    }

    match /tenantMemberships/{membershipId} {
      allow get: if isValidId(membershipId) && isVerified() && (
        (resource == null && (isAdmin() || membershipId.matches('^.+__' + request.auth.uid + '$'))) ||
        (resource != null && (existing().uid == request.auth.uid || (isAdmin() && docMatchesTenant(existing()))))
      );
      allow list: if isVerified() && (
        existing().uid == request.auth.uid ||
        (isAdmin() && docMatchesTenant(existing()))
      );
      allow create: if isValidId(membershipId) && isVerified() && isValidTenantMembership(incoming())
        && isValidTimestamp(incoming().createdAt)
        && isValidTimestamp(incoming().updatedAt)
        && (
          (
            !isPlatformSuperAdmin() &&
            incoming().uid == request.auth.uid &&
            incoming().email.lower() == tokenEmailLower() &&
            incoming().status == 'active' &&
            (
              incoming().role == 'candidate' ||
