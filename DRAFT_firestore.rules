rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Primitives, Tenant Isolation & Platform Role Helpers
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts == request.time;
    }

    function isBootstrappedSuperAdmin() {
      return isVerified() && 'email' in request.auth.token && request.auth.token.email == 'dr.aamir01@gmail.com';
    }

    function hasUserDoc() {
      return isVerified() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasSaasUserDoc() {
      return isVerified() && exists(/databases/$(database)/documents/saasUsers/$(request.auth.uid));
    }

    function currentSaasUser() {
      return get(/databases/$(database)/documents/saasUsers/$(request.auth.uid)).data;
    }

    function isPlatformSuperAdmin() {
      return isBootstrappedSuperAdmin()
        || (hasSaasUserDoc() && currentSaasUser().status == 'active' && 'platformRole' in currentSaasUser() && currentSaasUser().platformRole == 'platform_super_admin')
        || (hasUserDoc() && currentUser().status == 'active' && 'platformRole' in currentUser() && currentUser().platformRole == 'platform_super_admin');
    }

    function isActiveUser() {
      return !isPlatformSuperAdmin() && hasUserDoc() && currentUser().status == 'active';
    }

    function userRole() {
      return currentUser().role;
    }

    function userTenantId() {
      return (isActiveUser() && 'tenantId' in currentUser() && currentUser().tenantId is string)
        ? currentUser().tenantId
        : 'tenant_default';
    }

    function hasTenantMembership(tenantId) {
      return !isPlatformSuperAdmin()
        && isVerified()
        && isValidId(tenantId)
        && exists(/databases/$(database)/documents/tenantMemberships/$(tenantId + '__' + request.auth.uid))
        && get(/databases/$(database)/documents/tenantMemberships/$(tenantId + '__' + request.auth.uid)).data.status == 'active';
    }

    function tenantMembershipRole(tenantId) {
      return get(/databases/$(database)/documents/tenantMemberships/$(tenantId + '__' + request.auth.uid)).data.role;
    }

    function docMatchesTenant(data) {
      return !isPlatformSuperAdmin() && (
        ('tenantId' in data && data.tenantId is string && (data.tenantId == userTenantId() || hasTenantMembership(data.tenantId)))
        || (!('tenantId' in data) && userTenantId() == 'tenant_default')
      );
    }

    function incomingMatchesTenant(data) {
      return !isPlatformSuperAdmin() && (
        ('tenantId' in data && data.tenantId is string && (data.tenantId == userTenantId() || hasTenantMembership(data.tenantId)))
        || (!('tenantId' in data) && userTenantId() == 'tenant_default')
      );
    }

    function isSuperAdmin() {
      return !isPlatformSuperAdmin() && isActiveUser() && userRole() in ['super_admin', 'tenant_owner'];
    }

    function isAdmin() {
      return isSuperAdmin()
        || (isActiveUser() && userRole() in ['admin', 'tenant_admin']);
    }

    function isCertificateOfficer() {
      return isSuperAdmin() || (isActiveUser() && userRole() == 'certificate_officer');
    }

    function isTrainer() {
      return isActiveUser() && userRole() == 'trainer';
    }

    function isCorporateClient() {
      return isActiveUser() && userRole() == 'corporate_client';
    }

    function isStaff() {
      return isSuperAdmin() || isAdmin() || isCertificateOfficer() || isTrainer();
    }

    function isSameOrg(orgId) {
      return isCorporateClient() && 'organizationId' in currentUser() && currentUser().organizationId is string && currentUser().organizationId == orgId;
    }

    function tokenEmailLower() {
      return ('email' in request.auth.token && request.auth.token.email is string)
        ? request.auth.token.email.lower()
        : '';
    }

    function isPendingInviteDocForRole(invDoc, role) {
      return invDoc.data.status == 'pending' && invDoc.data.role == role;
    }

    function isPendingInviteDocForTenant(invDoc, tenantId) {
      return invDoc.data.status == 'pending'
        && (!('tenantId' in invDoc.data) || invDoc.data.tenantId == tenantId);
    }

    function hasPendingInviteForEmail(tenantId, role) {
      return tokenEmailLower().size() >= 3 && (
        (
          exists(/databases/$(database)/documents/userInvites/$(tenantId + '_' + hashing.sha256(tokenEmailLower()).toHexString().lower()[0:40])) &&
          isPendingInviteDocForRole(get(/databases/$(database)/documents/userInvites/$(tenantId + '_' + hashing.sha256(tokenEmailLower()).toHexString().lower()[0:40])), role)
        ) || (
          exists(/databases/$(database)/documents/userInvites/$(hashing.sha256(tokenEmailLower()).toHexString().lower()[0:40])) &&
          isPendingInviteDocForRole(get(/databases/$(database)/documents/userInvites/$(hashing.sha256(tokenEmailLower()).toHexString().lower()[0:40])), role)
        )
      );
    }

    function hasPendingInviteForTenant(tenantId) {
      return isVerified()
        && isValidId(tenantId)
        && tokenEmailLower().size() >= 3
        && (
          (
            exists(/databases/$(database)/documents/userInvites/$(tenantId + '_' + hashing.sha256(tokenEmailLower()).toHexString().lower()[0:40])) &&
            get(/databases/$(database)/documents/userInvites/$(tenantId + '_' + hashing.sha256(tokenEmailLower()).toHexString().lower()[0:40])).data.status == 'pending'
          ) || (
            exists(/databases/$(database)/documents/userInvites/$(hashing.sha256(tokenEmailLower()).toHexString().lower()[0:40])) &&
            isPendingInviteDocForTenant(get(/databases/$(database)/documents/userInvites/$(hashing.sha256(tokenEmailLower()).toHexString().lower()[0:40])), tenantId)
          )
        );
    }

    function matchesPendingTenantRegDoc(regDoc, tenantId) {
      return regDoc.data.ownerUid == request.auth.uid
        && regDoc.data.ownerEmail.lower() == tokenEmailLower()
        && regDoc.data.proposedTenantId == tenantId;
    }

    function hasPendingTenantRegistration(tenantId) {
      return isVerified()
        && isValidId(tenantId)
        && exists(/databases/$(database)/documents/pendingTenantRegistrations/$(request.auth.uid))
        && matchesPendingTenantRegDoc(get(/databases/$(database)/documents/pendingTenantRegistrations/$(request.auth.uid)), tenantId);
    }

    function matchesOwnedTenantDoc(tenantDoc) {
      return 'ownerUserId' in tenantDoc.data
        && tenantDoc.data.ownerUserId == request.auth.uid;
    }

    function ownsActiveRegisteredTenant(tenantId) {
      return isVerified()
        && isValidId(tenantId)
        && exists(/databases/$(database)/documents/saasTenants/$(tenantId))
        && matchesOwnedTenantDoc(get(/databases/$(database)/documents/saasTenants/$(tenantId)));
    }

    // -------------------------------------------------------------------------
    // SaaS Platform Entity Validation Helpers
    // -------------------------------------------------------------------------
    function isValidSaasTenant(data) {
      return data.keys().hasAll(['tenantId', 'tenantCode', 'nameEn', 'nameAr', 'slug', 'status', 'planCode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'tenantCode', 'nameEn', 'nameAr', 'legalName', 'crNumber', 'vatNumber', 'slug', 'contactEmail', 'contactPhone', 'country', 'city', 'address', 'website', 'status', 'planCode', 'billingCycle', 'trialStartsAt', 'trialEndsAt', 'isDefaultLegacyTenant', 'migrationCompleted', 'onboardingCompleted', 'defaultLanguage', 'timezone', 'ownerUserId', 'createdBy', 'activatedAt', 'migratedAt', 'migratedBy', 'createdAt', 'updatedAt'])
        && isValidId(data.tenantId)
        && data.tenantCode is string && data.tenantCode.size() >= 2 && data.tenantCode.size() <= 32
        && data.nameEn is string && data.nameEn.size() >= 2 && data.nameEn.size() <= 200
        && data.nameAr is string && data.nameAr.size() >= 2 && data.nameAr.size() <= 200
        && (!('legalName' in data) || (data.legalName is string && data.legalName.size() <= 240))
        && (!('crNumber' in data) || (data.crNumber is string && data.crNumber.size() <= 64))
        && (!('vatNumber' in data) || (data.vatNumber is string && data.vatNumber.size() <= 40))
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 120
        && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 200))
        && (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 40))
        && (!('country' in data) || (data.country is string && data.country.size() <= 80))
        && (!('city' in data) || (data.city is string && data.city.size() <= 120))
        && (!('address' in data) || (data.address is string && data.address.size() <= 400))
        && (!('website' in data) || (data.website is string && data.website.size() <= 200))
        && data.status in ['trial', 'active', 'grace_period', 'suspended', 'cancelled']
        && data.planCode is string && data.planCode.size() >= 2 && data.planCode.size() <= 48
        && (!('billingCycle' in data) || data.billingCycle in ['monthly', 'annual'])
        && (!('trialStartsAt' in data) || (data.trialStartsAt is string && data.trialStartsAt.size() <= 40))
        && (!('trialEndsAt' in data) || (data.trialEndsAt is string && data.trialEndsAt.size() <= 40))
        && (!('isDefaultLegacyTenant' in data) || data.isDefaultLegacyTenant is bool)
        && (!('migrationCompleted' in data) || data.migrationCompleted is bool)
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool)
        && (!('defaultLanguage' in data) || data.defaultLanguage in ['en', 'ar'])
        && (!('timezone' in data) || (data.timezone is string && data.timezone.size() <= 64))
        && (!('ownerUserId' in data) || (data.ownerUserId is string && data.ownerUserId.size() <= 128))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && (!('activatedAt' in data) || (data.activatedAt is string && data.activatedAt.size() <= 40))
        && (!('migratedAt' in data) || (data.migratedAt is string && data.migratedAt.size() <= 40))
        && (!('migratedBy' in data) || (data.migratedBy is string && data.migratedBy.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSaasUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'preferredLanguage', 'platformRole', 'defaultTenantId', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('preferredLanguage' in data) || data.preferredLanguage in ['en', 'ar'])
        && (!('platformRole' in data) || data.platformRole in ['platform_super_admin', 'platform_admin', 'platform_support', 'platform_finance'])
        && (!('defaultTenantId' in data) || (data.defaultTenantId is string && data.defaultTenantId.size() <= 128))
        && data.status in ['active', 'suspended']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTenantMembership(data) {
      return data.keys().hasAll(['tenantId', 'uid', 'email', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'uid', 'email', 'displayName', 'role', 'status', 'organizationId', 'trainerId', 'candidateId', 'isDefault', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.tenantId)
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 160))
        && data.role in ['super_admin', 'tenant_owner', 'admin', 'tenant_admin', 'certificate_officer', 'trainer', 'corporate_client', 'candidate']
        && data.status in ['active', 'invited', 'suspended']
        && (!('organizationId' in data) || (data.organizationId is string && data.organizationId.size() <= 128))
        && (!('trainerId' in data) || (data.trainerId is string && data.trainerId.size() <= 128))
        && (!('candidateId' in data) || (data.candidateId is string && data.candidateId.size() <= 128))
        && (!('isDefault' in data) || data.isDefault is bool)
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlatformSettings(data) {
      return data.keys().hasAll(['key', 'config', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['key', 'config', 'updatedBy', 'updatedAt'])
        && data.key is string && data.key.size() <= 64
        && data.config is map
        && data.updatedBy is string && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidPlatformAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'platformRole', 'action', 'entityType', 'entityId', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorEmail', 'platformRole', 'action', 'entityType', 'entityId', 'tenantId', 'details', 'createdAt'])
        && data.actorUid is string && data.actorUid.size() <= 128
        && (!('actorEmail' in data) || (data.actorEmail is string && data.actorEmail.size() <= 200))
        && data.platformRole in ['platform_super_admin', 'platform_admin', 'platform_support', 'platform_finance']
        && data.action is string && data.action.size() <= 120
        && data.entityType is string && data.entityType.size() <= 80
        && data.entityId is string && data.entityId.size() <= 128
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && (!('details' in data) || (data.details is string && data.details.size() <= 2000))
        && data.createdAt is timestamp;
    }

    function isValidSubscriptionPlan(data) {
      return data.keys().hasAll(['code', 'nameEn', 'nameAr', 'priceMonthly', 'priceAnnual', 'currency', 'isActive', 'updatedAt'])
        && data.keys().hasOnly(['code', 'nameEn', 'nameAr', 'taglineEn', 'taglineAr', 'priceMonthly', 'priceAnnual', 'currency', 'recommended', 'isActive', 'displayOrder', 'featuresEn', 'featuresAr', 'limits', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 48
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 120
        && (!('taglineEn' in data) || (data.taglineEn is string && data.taglineEn.size() <= 240))
        && (!('taglineAr' in data) || (data.taglineAr is string && data.taglineAr.size() <= 240))
        && data.priceMonthly is number && data.priceMonthly >= 0
        && data.priceAnnual is number && data.priceAnnual >= 0
        && data.currency is string && data.currency.size() >= 2 && data.currency.size() <= 8
        && (!('recommended' in data) || data.recommended is bool)
        && data.isActive is bool
        && (!('displayOrder' in data) || data.displayOrder is number)
        && (!('featuresEn' in data) || (data.featuresEn is list && data.featuresEn.size() <= 20 && (data.featuresEn.size() == 0 || data.featuresEn[0] is string)))
        && (!('featuresAr' in data) || (data.featuresAr is list && data.featuresAr.size() <= 20 && (data.featuresAr.size() == 0 || data.featuresAr[0] is string)))
        && (!('limits' in data) || data.limits is map)
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidPlatformLead(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'companyName', 'subject', 'message', 'preferredLanguage', 'status', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 200))
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 3000
        && (!('preferredLanguage' in data) || data.preferredLanguage in ['en', 'ar'])
        && data.status in ['new', 'reviewed', 'resolved']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPendingTenantRegistration(data) {
      return data.keys().hasAll(['ownerUid', 'ownerEmail', 'ownerDisplayName', 'proposedTenantId', 'nameEn', 'planCode', 'billingCycle', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'ownerEmail', 'ownerDisplayName', 'ownerMobile', 'proposedTenantId', 'nameEn', 'nameAr', 'legalName', 'crNumber', 'vatNumber', 'country', 'city', 'address', 'website', 'companyEmail', 'companyPhone', 'planCode', 'billingCycle', 'defaultLanguage', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && data.ownerEmail is string && data.ownerEmail.size() >= 3 && data.ownerEmail.size() <= 200
        && data.ownerDisplayName is string && data.ownerDisplayName.size() >= 2 && data.ownerDisplayName.size() <= 160
        && (!('ownerMobile' in data) || (data.ownerMobile is string && data.ownerMobile.size() <= 32))
        && isValidId(data.proposedTenantId)
        && data.nameEn is string && data.nameEn.size() >= 2 && data.nameEn.size() <= 200
        && (!('nameAr' in data) || (data.nameAr is string && data.nameAr.size() <= 200))
        && (!('legalName' in data) || (data.legalName is string && data.legalName.size() <= 240))
        && (!('crNumber' in data) || (data.crNumber is string && data.crNumber.size() <= 64))
        && (!('vatNumber' in data) || (data.vatNumber is string && data.vatNumber.size() <= 40))
        && (!('country' in data) || (data.country is string && data.country.size() <= 80))
        && (!('city' in data) || (data.city is string && data.city.size() <= 120))
        && (!('address' in data) || (data.address is string && data.address.size() <= 400))
        && (!('website' in data) || (data.website is string && data.website.size() <= 200))
        && (!('companyEmail' in data) || (data.companyEmail is string && data.companyEmail.size() <= 200))
        && (!('companyPhone' in data) || (data.companyPhone is string && data.companyPhone.size() <= 40))
        && data.planCode is string && data.planCode.size() >= 2 && data.planCode.size() <= 48
        && data.billingCycle in ['monthly', 'annual']
        && (!('defaultLanguage' in data) || data.defaultLanguage in ['en', 'ar'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Entity Validation Helpers (Anti-Update-Gap Blueprints)
    // -------------------------------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'preferredLanguage', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'role', 'tenantId', 'platformRole', 'organizationId', 'trainerId', 'candidateId', 'permissions', 'preferredLanguage', 'status', 'lastLoginAt', 'lastAuthTime', 'authProvider', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && data.role in ['super_admin', 'tenant_owner', 'admin', 'tenant_admin', 'certificate_officer', 'trainer', 'corporate_client', 'candidate']
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && (!('platformRole' in data) || data.platformRole in ['platform_super_admin', 'platform_admin', 'platform_support', 'platform_finance'])
        && data.preferredLanguage in ['en', 'ar']
        && data.status in ['active', 'suspended']
        && (!('organizationId' in data) || (data.organizationId is string && data.organizationId.size() <= 128))
        && (!('trainerId' in data) || (data.trainerId is string && data.trainerId.size() <= 128))
        && (!('candidateId' in data) || (data.candidateId is string && data.candidateId.size() <= 128))
        && (!('permissions' in data) || data.permissions is map)
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 40))
        && (!('lastAuthTime' in data) || (data.lastAuthTime is number && data.lastAuthTime >= 0))
        && (!('authProvider' in data) || (data.authProvider is string && data.authProvider.size() <= 40))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserInvite(data) {
      return data.keys().hasAll(['email', 'role', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'email', 'displayName', 'role', 'organizationId', 'trainerId', 'candidateId', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 160))
        && data.role in ['super_admin', 'tenant_owner', 'admin', 'tenant_admin', 'certificate_officer', 'trainer', 'corporate_client', 'candidate']
        && data.status in ['pending', 'claimed', 'revoked']
        && (!('organizationId' in data) || (data.organizationId is string && data.organizationId.size() <= 128))
        && (!('trainerId' in data) || (data.trainerId is string && data.trainerId.size() <= 128))
        && (!('candidateId' in data) || (data.candidateId is string && data.candidateId.size() <= 128))
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCandidate(data) {
      return data.keys().hasAll(['candidateId', 'fullNameEn', 'fullNameAr', 'nationality', 'mobile', 'registrationDate', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'candidateId', 'userId', 'fullNameEn', 'fullNameAr', 'gender', 'iqamaEncrypted', 'iqamaMasked', 'iqamaHash', 'iqamaExpiryDate', 'passportEncrypted', 'passportMasked', 'passportHash', 'passportExpiryDate', 'nationality', 'dateOfBirth', 'mobile', 'email', 'organizationId', 'companyName', 'employeeId', 'jobTitle', 'department', 'workLocation', 'address', 'emergencyContact', 'notes', 'photoFileId', 'registrationDate', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.candidateId is string && data.candidateId.size() >= 3 && data.candidateId.size() <= 40
        && data.fullNameEn is string && data.fullNameEn.size() >= 2 && data.fullNameEn.size() <= 200
        && data.fullNameAr is string && data.fullNameAr.size() >= 2 && data.fullNameAr.size() <= 200
        && (!('gender' in data) || data.gender in ['male', 'female'])
        && data.nationality is string && data.nationality.size() >= 2 && data.nationality.size() <= 100
        && data.mobile is string && data.mobile.size() >= 5 && data.mobile.size() <= 32
        && data.registrationDate is string && data.registrationDate.size() <= 32
        && data.status in ['active', 'inactive', 'archived', 'suspended']
        && data.createdBy is string && data.createdBy.size() <= 128
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('iqamaEncrypted' in data) || (data.iqamaEncrypted is string && data.iqamaEncrypted.size() <= 512))
        && (!('iqamaMasked' in data) || (data.iqamaMasked is string && data.iqamaMasked.size() <= 32))
        && (!('iqamaHash' in data) || (data.iqamaHash is string && data.iqamaHash.size() <= 128))
        && (!('iqamaExpiryDate' in data) || (data.iqamaExpiryDate is string && data.iqamaExpiryDate.size() <= 32))
        && (!('passportEncrypted' in data) || (data.passportEncrypted is string && data.passportEncrypted.size() <= 512))
