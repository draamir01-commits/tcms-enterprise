    function isValidTemplate(data) {
      return data.keys().hasAll(['name', 'scope', 'version', 'isDefault', 'config', 'updatedBy', 'createdAt', 'updatedAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && data.scope in ['common', 'course']
        && (!('courseId' in data) || (data.courseId is string && data.courseId.size() <= 128))
        && (!('languageMode' in data) || data.languageMode in ['bilingual', 'en', 'ar'])
