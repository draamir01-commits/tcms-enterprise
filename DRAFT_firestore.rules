        && (!('organizationId' in data) || (data.organizationId is string && data.organizationId.size() <= 128))
        && data.courseId is string && data.courseId.size() <= 128
        && data.batchId is string && data.batchId.size() <= 128
        && (!('templateId' in data) || (data.templateId is string && data.templateId.size() <= 128))
        && (!('templateName' in data) || (data.templateName is string && data.templateName.size() <= 160))
        && (!('templateVersion' in data) || (data.templateVersion is number && data.templateVersion >= 1))
        && data.qrTokenHash is string && data.qrTokenHash.size() <= 128
        && data.pdfFileId is string && data.pdfFileId.size() <= 256
        && data.version is number && data.version >= 1
        && data.status in ['active', 'superseded', 'revoked']
        && (!('snapshot' in data) || data.snapshot is map)
        && data.generatedBy is string && data.generatedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidCertificate(data) {
      return data.keys().hasAll(['certificateNumber', 'enrollmentId', 'candidateDocId', 'candidateId', 'courseId', 'batchId', 'tokenHash', 'pdfFileId', 'issueDate', 'completionDate', 'status', 'issuedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'certificateNumber', 'enrollmentId', 'candidateDocId', 'candidateId', 'candidateUserId', 'organizationId', 'courseId', 'batchId', 'templateId', 'templateVersion', 'tokenHash', 'pdfFileId', 'issueDate', 'completionDate', 'expiryDate', 'status', 'revocationReason', 'revokedBy', 'supersededBy', 'issuedBy', 'snapshot', 'createdAt', 'updatedAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.certificateNumber is string && data.certificateNumber.size() <= 64
        && data.enrollmentId is string && data.enrollmentId.size() <= 128
        && data.candidateDocId is string && data.candidateDocId.size() <= 128
        && data.candidateId is string && data.candidateId.size() <= 64
        && (!('candidateUserId' in data) || (data.candidateUserId is string && data.candidateUserId.size() <= 128))
        && (!('organizationId' in data) || (data.organizationId is string && data.organizationId.size() <= 128))
        && data.courseId is string && data.courseId.size() <= 128
        && data.batchId is string && data.batchId.size() <= 128
        && (!('templateId' in data) || (data.templateId is string && data.templateId.size() <= 128))
        && (!('templateVersion' in data) || data.templateVersion is number)
        && data.tokenHash is string && data.tokenHash.size() <= 128
        && data.pdfFileId is string && data.pdfFileId.size() <= 256
        && data.issueDate is string && data.issueDate.size() <= 32
        && data.completionDate is string && data.completionDate.size() <= 32
        && (!('expiryDate' in data) || (data.expiryDate is string && data.expiryDate.size() <= 32))
        && data.status in ['valid', 'expired', 'revoked', 'superseded']
        && (!('revocationReason' in data) || (data.revocationReason is string && data.revocationReason.size() <= 500))
        && (!('revokedBy' in data) || (data.revokedBy is string && data.revokedBy.size() <= 128))
        && (!('supersededBy' in data) || (data.supersededBy is string && data.supersededBy.size() <= 64))
        && data.issuedBy is string && data.issuedBy.size() <= 128
        && (!('snapshot' in data) || data.snapshot is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicVerification(data) {
      return data.keys().hasAll(['lookupKey', 'certificateNumber', 'candidateNameEn', 'courseTitleEn', 'completionDate', 'issueDate', 'issuingCenterEn', 'status', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'lookupKey', 'certificateNumber', 'candidateNameEn', 'candidateNameAr', 'courseTitleEn', 'courseTitleAr', 'completionDate', 'issueDate', 'expiryDate', 'issuingCenterEn', 'issuingCenterAr', 'status', 'supersededBy', 'updatedAt'])
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && data.lookupKey is string && data.lookupKey.size() <= 128
        && data.certificateNumber is string && data.certificateNumber.size() <= 64
        && data.candidateNameEn is string && data.candidateNameEn.size() <= 200
        && (!('candidateNameAr' in data) || (data.candidateNameAr is string && data.candidateNameAr.size() <= 200))
        && data.courseTitleEn is string && data.courseTitleEn.size() <= 220
        && (!('courseTitleAr' in data) || (data.courseTitleAr is string && data.courseTitleAr.size() <= 220))
        && data.completionDate is string && data.completionDate.size() <= 32
        && data.issueDate is string && data.issueDate.size() <= 32
        && (!('expiryDate' in data) || (data.expiryDate is string && data.expiryDate.size() <= 32))
        && data.issuingCenterEn is string && data.issuingCenterEn.size() <= 200
        && (!('issuingCenterAr' in data) || (data.issuingCenterAr is string && data.issuingCenterAr.size() <= 200))
